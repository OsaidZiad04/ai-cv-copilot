# mock works without a key. guided skips all LLM calls. groq uses the server-side key.
LLM_PROVIDER=mock
GROQ_API_KEY=
# Pick a current chat-completions model from https://console.groq.com/docs/models
GROQ_MODEL=

# Email delivery is disabled unless explicitly enabled. Server-side values only.
CV_EMAIL_SEND_ENABLED=false
BREVO_API_KEY=
CV_EMAIL_FROM=
CV_EMAIL_FROM_NAME=AI CV Copilot
